auth:
  username: "postgres"
  password: "${password}"
  postgresPassword: "${password}"

rbac:
  create: true

metrics:
  enabled: true
  serviceMonitor:
    enabled: true

primary:
  resources:
    limits:
      cpu: "500m"
      memory: "1Gi"
    requests:
      cpu: "250m"
      memory: "256Mi"
  persistence:
    # resource group "backup": shipped to Garage S3 (db/garage.tf)
    storageClass: "${storage_class}-backup"
