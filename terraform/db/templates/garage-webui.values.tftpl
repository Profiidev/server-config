config:
  server:
    domain: "garage.profidev.io"
    protocol: "https"
    root_url: "https://garage.profidev.io"

  garage:
    endpoint: "http://garage.garage.svc.cluster.local:3900"
    region: "garage"
    admin_endpoint: "http://garage-0.garage-headless.${namespace}.svc.cluster.local:3903"

ingress:
  enabled: true
  className: ${ingress_class}
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: "${namespace}-garage@kubernetescrd"
    traefik.ingress.kubernetes.io/router.tls.options: "${namespace}-garage-tls-options@kubernetescrd"
    external-dns.alpha.kubernetes.io/ingress-hostname-source: "annotation-only"
    external-dns.alpha.kubernetes.io/cloudflare-proxied: "true"
    external-dns.alpha.kubernetes.io/hostname: "garage.profidev.io"
    external-dns.alpha.kubernetes.io/target: "cluster.profidev.io"
  hosts:
    - host: garage.profidev.io
      paths:
        - pathType: "Prefix"
          path: /
  tls:
    - secretName: ${cloudflare_cert}
      hosts:
        - "*.profidev.io"
        - "profidev.io"
